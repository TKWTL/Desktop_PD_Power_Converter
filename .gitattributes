# Line-ending policy for a Windows-only embedded toolchain project.
# Firmware sources are plain text; let Git store LF internally and give the
# Windows tools (MounRiver Studio / Eclipse) CRLF on checkout, which is what
# they write themselves.
* text=auto

# MounRiver / Eclipse project files are XML: keep CRLF so local edits do not
# show up as whole-file diffs.
*.cproject text eol=crlf
*.project  text eol=crlf
*.wvproj   text eol=crlf
*.launch   text eol=crlf

# Never let Git touch binary assets: a schematic PDF or an image must survive
# a checkout byte for byte.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.ico  binary
*.hex  binary
*.bin  binary
*.elf  binary
*.a    binary
*.lib  binary
*.zip  binary
*.xls  binary
*.xlsx binary
*.doc  binary
*.docx binary

# LCEDA / EasyEDA Pro project files are ZIP containers, not text: keep them
# byte-exact and never diff them as text (Hardware/source/ProPrj_*.epro2).
*.epro2 binary
*.epro  binary
*.eprj  binary

# Archives and mechanical exports that may follow the first manufacturing
# package (the Gerber *.zip and schematic *.pdf under Hardware/ are already
# covered by the generic rules above).
*.rar  binary
*.7z   binary
*.tar  binary
*.gz   binary
*.stl  binary
*.step binary
*.stp  binary
*.3mf  binary
*.dxf  binary
